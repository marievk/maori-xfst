āhua   NandV ; ! V: "form, make", N: "shape, appearance"
ū      NandV ; ! V: "comply, reach the land, arrive by water"

! (5) Split towards noun/verb tagging:
LEXICON NandV
 NTag  ;
 VTag  ;

! 1. (Common) nouns -----------------------------------------
! (6) Separation between different noun forms:
LEXICON Nouns
 Noun    ;
 PlNouns ;
 DateTime ;

