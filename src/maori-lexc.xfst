tuakana  SgNounTag   ; ! "older sibling (same sex)""
tuākana  PlNounTag   ;
tupuna   SgNounTag   ; ! "ancestor"
tūpuna   PlNounTag   ;
wahine   SgNounTag   ; ! "woman"
wāhine   PlNounTag   ;
whaea    SgNounTag   ; ! "mother"
whāea    PlNounTag   ;

