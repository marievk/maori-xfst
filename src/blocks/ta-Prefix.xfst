Multichar_Symbols +V +N +ag
    @P.PREF.Tā@

! tā- as another causative prefix

LEXICON root
@P.PREF.Tā@caus+:@P.PREF.Tā@tā TāVerbs;  ! for verbs which allow tā-prefix (separate lexicon)
                               TāVerbs;  ! ... for making the prefix optional

LEXICON TāVerbs
piri   VTag ; ! "stick, keep close together" -> tāpiri "join, add, append"
mahana VTag ; ! "be warm" -> tāmahana "warm up, reheat food"

LEXICON VTag
+V:0   #;

! ---------------------------------------------
! cd .../xfsm_api/linux64/bin/
! ./xfst
! read lexc .../blocks/ta-Prefix.xfst
! print lower-words | sort
! print upper-words | sort
! print upper-words; print lower-words
