! Labels:
Multichar_Symbols +N +V +Det +Adj +Prep +Pron +Poss +Loc
      +Part +PartDir +PartMnr +PartLoc +Intj +Neg +Tns +Mde +Asp
      +sg +1sg +2sg +3sg +dl +1dl-incl +1dl-excl +1pl +1pl-incl +1pl-excl+pl +2pl +3pl
      caus+ +def +indef  +num +card +ord +prox1 +prox2 +nom +pass +q +afo
      ^[ ^] CV^R+ ^R Con Vow
      @P.PREF.Tā@
      @P.PREF.Whaka@ @D.PREF.Whaka@
      @P.PREF.Kai@   @D.PREF.Kai@   @R.PREF.Kai@

! Basic Branches -------------------------------------------------
! (3) Roots as basic branches:
LEXICON Root
 Bases ;
 Nouns ;
 Verbs ;
 Statives ;
 Locatives ;
 Personals ;
 Particles ;
 Prefixes ;
! Continuation class: leading whitespace (nothing to see, space, continuation classs)

! (43) Prefix dispatching table
LEXICON Prefixes
@P.PREF.Whaka@caus+:@P.PREF.Whaka@whaka Locatives;   ! defauls/preset for locatives, additional branch => both is allowed, no additional tag
@P.PREF.Whaka@caus+:@P.PREF.Whaka@whaka WhakaVerbs;  ! for verbs which allow whaka-prefix (additional lexicon)
                                        WhakaVerbs;  ! ... for making the prefix optional
@P.PREF.Tā@caus+:@P.PREF.Tā@tā TāVerbs;  ! same structure for verbs which allow tā-prefix
                               TāVerbs;  ! ... for making the prefix optional

@P.PREF.Kai@ag+:@P.PREF.Kai@kai KaiVerbs ;      ! -kai Nominalisation ...
                                KaiVerbs ;      ! ... remaining verbs

! 0 - Bases  -----------------------------------------------------------
! (4) Bases: terms that are used as Nouns and as Verbs
! most lexical/content verbs do have a noun usage
LEXICON Bases
aroha  NandV ; ! V: "love, feel pity, empathise", N:"affection, sympathy, charity"
aru    NandV ; ! V: "follow, pursue, chase", N: "pursuit, chase"
auahi  NandV ; ! V: "to be smoky", N: "smoke"
auau   NandV ; ! V: "be frequent, frequently, recurring", N: "frequency, rate"
eke    NandV ; ! V: " climb, ascend, rise"
hapū   NandV ; ! V: "be pregnant, conceived in the womb", N: "kinship group, clan, tribe, subtribe"
haramai NandV ; ! V: "to come, arrive", N: "arrival, visit"
hau    NandV ; ! V: "to exceed, be in excess", N: "excess"
heke   NandV ; ! V: "descend, get off, disembark, fall, drip", N: "migration, emigrant"
hiahia NandV ; ! V: "desire, wish for, want, crave, need", N: "desire, wish, need, want, aspiration, hope"
hoa    NandV ; ! V: "to lay out, plan arrange", N: "friend, companion, mate"
horoi  NandV ; ! V:"wash, clean, wipe", N:"washing, soap"
hou    NandV ; ! V: "to enter", N: "feather"
hua    NandV ; ! V: "originate, flower, bloom, blossom", N: "product, fruit, berry, math: answer, solution, product"
hui    NandV ; ! V: "gather, assemble, meet", N: "meeting, seminar, conference"
hukapapa NandV ; ! V:"to have a frost", N: "frost"
huri  NandV ; ! V: "turn, revolve, rotate, overwhelm", N: "revolution, rotation, mill"
hē    NandV ; ! V: "be wrong, mistaken, incorrect, be in trouble", N: "error, fault, mistake, difficulty"
ingoa NandV ; ! V: "to name, acquire distinction", N: "name"
inu   NandV ; ! V: "to drink", N: "drink"
irirangi NandV ; ! V: "be restless, unsettled, uneasy, edgy,, N: "radio wave"
kaha  NandV ; ! V: "be strong, capable, courageous, intense, energetic", N: "force, pressure"
kai   NandV ; ! V:"eat, consume, drink", N: "food, meal"
karauna  NandV ; ! V: "to crown", N: "crown, government" (loan)
kite  NandV ; ! V: "see, perceive, discover, detect", N: "seeing, perceiving, finding" (experience verb)
kupu  NandV ; ! V: "to speak", N: "word, vocabulary, saying, talk, message, statement, utterance, lyric"
kutētē NandV ; ! V: "to squeeze out (fluid), milk", N: "espresso machine"
kāwana NandV ; ! V: "govern", N: "governor, ruler" (loan).
kī     NandV ; ! V: "say, speak, mention, tell", N: "saying, word"
kōrero KaiAgentiv ; !  => kaikōrero "speaker"
kōrero NTag ; ! V: "tell, say, speak, read, talk, address", N: "speech, narrative, story, news, discussion"
mihi   NandV ; ! V: "greet, pay tribute,, N: "speech of greeting, acknowledgement"
minita NandV ; ! V: "to minister, service", N: "minister, reverend" (loan)
moana NandV ; ! V: "to be uneven", N: "sea, ocean, large lake"
mokopuna NandV ; ! V: " to be a grandchild", N: "grandchild(ren)"
muri  NandV ; ! V: "to sigh, grieve, mourn", N: "breeze"
mutu  NandV ; ! V: "to wipe out, forgive", N: "core element, essence, amputee"
mātaitai  NandV ; ! V: "be brackish, tasting of salt, salty" N:"salinity, saline"
mātotoru  NandV ; ! V: "be thick, dense", N: "thickness"
nui  NandV ; ! N: "size, quantity, importance", V: "be large, big, many"
oma  NandV ; ! V: "run, race, flee, escape", N: "running, fleeing, escape"
ora  NandV ; ! V: "be alive, well, safe, recover" , N: "life, health, vitality."
pei  NandV ; ! V: "to be paid", N: "pay, wages" (loan)
