mono  VTag ;     ! "to calk"
mono  aPassive ; ! -> monoa
māriri   VTag ; ! "to be tranquillised, soothed", N: "peace, tranquillity"
mātau VNranga ; ! V: "to know, acquainted with, understand" => -ranga mātauranga "knowledge, wisdom"
ngau  VTag ;       ! "to act upon, affect, afflict"
ngau  aPassive ;   !  -> ngaua
ngau  ngaPassive ; !  -> ngaungia
noho  VNanga  ; ! V: "sit, stay" => -anga nohoanga "place for sitting, chair"
ope   VTag ;       ! "to gather"
ope   hiaPassive ; ! -> opehia
paa   VTag ;       ! "touch"
paa   ngiaPassive; !->  paangia
pae    VTag ; ! "to demolish, throw down"
pai   VTag ;        ! "good"
pai   ngiaPassive ; !  -> paingia
paihere  VTag ;       ! "to bind in bundles"
paihere  tiaPassive ; ! -> paiheretia
pakanga  VTag ;       ! V: "to fight, battle, wage war, be at war with"
pakanga  tiaPassive ; ! V: "to fight, battle, wage war, be at war with"
puehu VTag ; ! "to get dusty, hazy"
puehu tiaPassive ; ! -> puehutia
pupuhi VTag ;       ! "to swell, expand, swelling, bloated"
pupuhi ngiaPassive ; !  -> pupuhingia
pānui VTag ;       ! "to announce, publish, proclaim, speak aloud, narrate"
pānui hiaPassive ; ! -> pānuihia
pānui tiaPassive ; ! -> pānuitia
pēhea VTag  ; ! "how? how about? what about?"
pēhea tiaPassive  ; ! -> pēhea
pērā  VTag ;      ! V: "act like that, behave/treat in that way"
pēwhea  VNtanga    ; ! V: "like what?, how?" -> peewheatanga "plan, method"
pēwhea  tiaPassive ; ! -> pēwheatia
pōnē  VTag ; ! "be in difficulties, troubled"
pū    VTag ;       ! "to blow gently"
pū    hiaPassive ; ! -> pūhia
raranga VTag ;     ! "to knit (a native basket)" -> rangahia
rere  VTag ;        ! "sail as a boat, and to flow as water"
rere  ngiaPassive ; ! -> rerengia
roko  VTag ;      ! "be overtaken"
roko  hinaPassive;! -> rokohina
ruku  VTag ;       ! "dive"
ruku  hiaPassive ; ! -> rukuhia
taataa VTag ;     ! "break"
taataa kinaPassive;! -> taataakina
tae   VTag ;     ! V: "to arrive, achieve, reach"
tae   aPassive ; ! V: -> taea "be able, accomplished, possible"
takoto VTag ;       ! "to lie"
takoto riaPassive ; ! -> takotoria
tangi VNhanga; ! V: "weep, cry, sound" => -hanga tangihanga "funeral, mourning"
tanu  VNmanga    ; ! V: "bury, plant" -> tanumanga "burial"
tanu  tiaPassive ; ! -> tanumia
tao   VNnga  ; ! V: "to weigh down" => -nga taonga N: "property, goods, possession"
tata  VTag   ; ! V: "be near, close, nearby, closely"
tika  VNnga  ; ! V: "to be correct, true, upright" => -nga tikanga N: "method, manner, rule"
toko VTag ;      ! "to propel by poles"
toko naPassive ; ! -> tokona
tu   VTag ;       ! "to stand"
tu   riaPassive ; ! -> turia
tua  VTag ;       ! "to fell (as a tree,)"
tua  inaPassive ; ! -> tuaina
tua  kinaPassive; ! -> tuakina.
tāpu VTag        ; ! "to stop, halt, cease" (loan)
tāpu ngiaPassive ; ! - > tāpungia
tāpu tiaPassive  ; ! - > tāputia
utu  VTag ;     ! "to pay"
utu  aPassive ; ! -> utua
waha VNnga  ; ! V: "to carry on the back, raise up" => wāhanga N: "section, chapter, division, part, "
waiho  0Passive ; ! -> waiho
waiho  VTag ;     ! "leave"
wakama VTag ;       ! "to make clean"
wakama kiaPassive ; ! -> wakamakia
wete VTag ;        ! "untie, release"
wete kinaPassive ; ! -> wetekina "be untied/released"
whakaae  VTag ;       ! whakāe (45): "agree, assent to"
whakaae  hiaPassive ; ! -> whakaaehia
whakaae  ngiaPassive; ! -> whakaaengia
whakaae  tiaPassive ; ! -> whakaaetia
whakahou VTag ;        ! "to make new, renew, enter"
whakahou ngiaPassive ; ! -> whakahoutia
whakahou tiaPassive  ; ! -> whakahoutia
whakakao VTag ; ! "to collect)"
whakangongo VTag ; ! "to neglect, pay no attention"
whakapae VTag ;     ! "suspect, accuse falsely, throw down."
whakapae aPassive ; ! -> whakapaea
whakatau VTag ; ! "to decide, settle, prepare, determine, arbitrate, adjudicate"
whakateka VTag ;       ! "to denounce as false"
whakateka inaPassive ; ! -> wakatekaina
whakateka tiaPassive ; ! -> wakatekatia
whakatō VTag ;        ! "to sow, plant, insert"
whakatō hiaPassive ; ! -> wakatōkia
whakatō kiaPassive ; ! -> wakatōkia
whakatō ngiaPassive ; ! -> wakatōngia
whakatū VTag   ; ! V: "to elect, put on, to make stand, erect"
whakau VTag ;        ! "to kindle"
whakau ngiaPassive ; ! -> whakaungia
whaki  VTag ;       ! "to confess" -> whakina
whaki  naPassive ; ! -> whakina
whakāea VTag ;      ! V: "avenge, realise, recompense, repay"
whangai VTag ;   ! "to feed"
whangai aPassive ;   ! -> whangaia
whangai ngaPassive ; !-> whangainga
whao VTag ;        ! "insert, fill"
whao naPassive ;   ! -> whaona
whao ngiaPassive ; !  -> whaongia
whao riaPassive ;  ! -> whaoria
whao whiaPassive ; ! -> whaowhia "be inserted/driven in"
whao whinaPassive ; ! -> whaowhina "be put into / be filled"
whawhai VTag ; ! "fight"
whākao  VTag ; ! "to collect"
whāngongo VTag ; ! "to administer food to someone"
wānanga VTag ;       ! "meet and discuss, consider"
wānanga hiaPassive ; ! -> wānangahia
wānanga tiaPassive ; ! -> wānangatia
āhua    VNtanga ; ! V: "to form, make" => -tanga āhuatanga N: "way, aspect, likeness"
āwhina  VTag ; ! "assist, help, support, benefit"

! (40) Passive with different suffixes:
LEXICON aPassive
+pass:a  VTag ;

LEXICON naPassive
+pass:na VTag ;

LEXICON ngaPassive
+pass:nga VTag ;

LEXICON iaPassive
+pass:ia VTag ;

LEXICON tiaPassive
+pass:tia VTag ;

LEXICON hiaPassive
+pass:hia VTag ;

LEXICON ngiaPassive
+pass:ngia VTag ;

LEXICON kiaPassive
+pass:kia VTag ;

LEXICON miaPassive
+pass:mia VTag ;

LEXICON riaPassive
+pass:ria VTag ;

LEXICON inaPassive
+pass:ina VTag ;

LEXICON whiaPassive
+pass:whia VTag ;

LEXICON whinaPassive
+pass:whina VTag ;

LEXICON hinaPassive
+pass:hina VTag ;

LEXICON kinaPassive
+pass:kina VTag ;

LEXICON 0Passive
+pass:0 VTag ;

! (44) Whaka-prefix
LEXICON WhakaVerbs
aro    VTag ; ! V: "take notice of, pay attention to", whakaaro: "take notice of, pay attention to"
haere  VTag ; ! V: "to go, depart, travel, come" -> whakahaere V: "to organise, cause to go,lead, execute"
keri   VTag ; ! "to dig, dig up, scratch out of the ground."
mārama VTag ; ! V: "be clear, light, easy" -> whakamārama V: "illuminate, explain, clarify"
mātaitai VTag ; ! V: " to be brackish, tasting of salt, salty"
paipai VTag ; ! V: whakapaipai: "make good, decorate"
rongo  VTag ; ! V: "to hear, feel, smell, taste, perceive" -> whakarongo "to listen, hear, taste, smell, feel."
taetae VTag ; ! V: "to arrive in groups", whakataetae: "to compete"
tupu   VNranga ; ! V: "to grow, increase", whakatupu "cause to grow" => -ranga whakatupuranga "generation"
āe     VTag ; ! V: "to agree, give assent", whakaae (rewrite-rule): "accept, approve, authorise"

! (72) tā- as another causative prefix
LEXICON TāVerbs
mahana VTag ; ! "be warm" -> tāmahana "warm up, reheat food"
piri   VTag ; ! "stick, keep close together" -> tāpiri "join, add, append"
uhi    VTag ; ! "cover" ->  tāuhi "cover"
uwhiuwhi  VTag ; ! "shower, sprinkle, spray" -> tāuwhiuwhi "sprinkle"

! (46) Nominalization via the agentive prefix kai- (only transitive verbs can take the prefix kai-)
! Added to action verbs to build nouns denoting a human agent.
! to build nouns denoting a human agent
LEXICON KaiVerbs
ako    KaiAgentiv ; ! V: "learn, study, instruct, teach, advise" => kaiako "teacher"
hoe    KaiAgentiv ; ! V: "to paddle, row" => kaihoe  "paddler, rowe"
hoko   KaiAgentiv ; !  => kaihoko "seller"
mahi   KaiAgentiv ; ! V:  "work, do, perform, make, raise (money)" => kaimahi "worker"
mahi   aPassive ; ! V: -> mahia "to be worked on/through"
peita  KaiAgentiv ; ! V: "paint" => kaipeita "painter"
tiaki  KaiAgentiv ; !  => kaitiaki "guardian, trustee"
tito   KaiAgentiv ; !  => kaitito "composer"
tuhi   KaiAgentiv ; ! V: "to write" => kaituhi "writer, author"
whakaako  KaiAgentiv ; ! like ako
whakahaere KaiAgentiv ; ! V: "organise, operate, lead, execute" => kaiwhakahaere "administrator, boss, director"

! (47) -kai branching: verb vs. noun
LEXICON KaiAgentiv
@R.PREF.Kai@ NTag ;
@D.PREF.Kai@ VTag ;

! (15) nga-nominalization, also: 'verbal nouns'
LEXICON VNnga
         VTag ; ! as verb
+nom:nga NTag ; ! as noun

! (16) anga-nominalization
LEXICON VNanga
          VTag ; ! as verb
+nom:anga NTag ; ! as noun

! (17) inga-nominalization
LEXICON VNinga
          VTag ; ! as verb
+nom:inga NTag ; ! as noun

! (18) hanga-nominalization
LEXICON VNhanga
           VTag ; ! as verb
+nom:hanga NTag ; ! as noun

! (19) ranga-nominalization
LEXICON VNranga
           VTag ; ! as verb
+nom:ranga NTag ; ! as noun

! (58) kanga-nominalization
LEXICON VNkanga
           VTag ; ! as verb
+nom:kanga NTag ; ! as noun

! (59) tanga-nominalization
LEXICON VNtanga
           VTag ; ! as verb
+nom:tanga NTag ; ! as noun

! (60) manga-nominalization
LEXICON VNmanga
           VTag ; ! as verb
+nom:manga NTag ; ! as noun

! (20) Verbs with full-stem reduplication (Verb=>Verb)
LEXICON VerbStems
hoko  CloseVBrack ; ! "buy, sell, trade" -> hokohoko "trade, barter, export"
kau   CloseVBrack ; ! "swim", kau(kau)
kimo  CloseVBrack ; ! "to blink, wink" -> kimokimo, " to blink frequently, twinkle"
meke  CloseVBrack ; ! "to punch", meke(meke) also used as noun
muku  CloseVBrack ; ! "wipe", muku(muku)
oma   CloseVBrack ; ! ... omaoma: "run repeatedly"
rahi  CloseVBrack ; ! "be large, big, numerous, great", rahirahi: "be thin, not thick, slim"
raku  CloseVBrack ; ! "to scratch, scrape", -> rakuraku ! V: "to scratch, scrape, rake, harrow"
tau   CloseVBrack ; ! "to land, alight, come to rest, settle down", -> tautau "suspend, hang in clusters, dangle"
tā    CloseVBrack ; ! "strike, beat, thump, throw down, tackle." V: tātā "to strike repeatedly / beat"
tō    CloseVBrack ; ! ... V: tōtō "to pull repeatedly"

! (21) Tagging for ordinary & reduplicated verb form
LEXICON CloseVBrack
0:}^]    VTag ; ! ordinary form
^R:}^2^] VTag ; ! reduplicated form

! (22) Verbs with full-stem reduplication verb => noun
LEXICON VerbDupNomin
ata   VDupNBrack ; ! ata  "reflection"=> ataata "video"
hiki  VDupNBrack ; ! hiki "lift"  => hikihiki "weightlifting"
huru  VDupNBrack ; ! V: "to rise (of the sun)", huruhuru N: "diffused light"
kawe  VDupNBrack ; ! kawe "carry" => kawekawe "freight and cartage"
meke  VDupNBrack ; ! meke "punch" => mekemeke "boxing" (also used as verb)
paru  VDupNBrack ; ! V: "be dirty, muddy, soiled", paruparu N: "dirt, soil, filth, mud"
tae   VDupNBrack ; ! tae "to arrive, achieve, reach" => taetae: "arrival"
tui   VDupNBrack ; ! tui "to lace, sew" => tuitui "lashing, sewing."
wae   VDupNBrack ; ! wae "to divide, part, separate" => waewae "foot, footprint."
wehe  VDupNBrack ; ! wehe "share" => wehewehe "division"

! (23) Tagging for ordinary verb & nominalization via reduplication
LEXICON VDupNBrack
0:}^]    VTag   ; ! ordinary form: verb
^R:}^2^] NTag ; ! reduplicated form: verb => noun

! (48) initial partial reduplication
! fixed-length reduplication: CV, V->V, like like tagalog in excercise  (pdf 496)
LEXICON IniVDup
CV^R+:ConVow IniDupVerbs  ;
           IniDupVerbs  ;

! (49) verbs that allow initial partial reduplication
LEXICON IniDupVerbs
kata VTag ; ! "laugh" -> kakata "frequent laughing"
mahi VTag ; ! "work" ->"mamahi, over-work"
patu VTag ; ! "trike, hit, beat, assault, kill" -> papatu "beat one another, clash, fight one another."
peke VTag ; ! "to jump, leap over, leap, spring" -> pepeke — "o hasten something"
rere VTag ; ! "to fly, escape" -> rerere — "to fly in all directions"
tahi VTag ; ! "clear away, set aside" -> tatahi "to be wide apart."
taki VTag ; ! "to lead, challenge" -> tataki "to lead/guide in succession"
tiro VTag ; ! "look at, inspect, examine"-> titiro "observe, survey"
tuku VTag ; ! "to release, let go, give up" -> tutuku "to let down repeatedly"

! Not included: final partial reduplikation (runtime)

! (24) Verb tagging
LEXICON VTag
+V:0   #;

! 3. Statives with neuter verbs and adjectives ---------------------------------
! (25) Statives:
! Can be used as verbs,  but not with passive endings and cannot used the kai-prefix.
! Some can also be used as nouns.
LEXICON Statives
 NeuterVerbs ;
 ParticipialAdjectives ;
 Adjectives ;
 Colours ;

! (61) Neuter Verbs: predicating a state, some do have an additional ...a- passive
LEXICON NeuterVerbs
hina   NTag ;   ! also N: "grey hair, greyness"
hina   STag ;   ! "be grey-haired, grey, pale in colour"
hāpai  STag ;   ! "be set out / set off"
hāpai  aPassive; ! -> hāpaia
kurī   STag ;   ! "be without purpose, with little cause"
maene  STag ;   ! "be smooth, soft to the touch"
mahue  STag ;   ! "be left behind"
mahue  tiaPassive ; ! -> mahuetia
maroke STag ;   ! "be dry, arid"
mataku STag ;   ! "be afraid, frightened, alarmed"
mate   STag ;   ! "be sick, dead"
māroa  STag ;   ! "be expressionless, unenthusiastic"
oti    STag ;   ! "be finished, be complete "
riro   STag ;   ! "be taken"
tae    STag ;   ! "be able, be possible"
tae    aPassive; ! -> taea

! (26) Tagging for statives ('+stativ' was dismissed)
LEXICON STag
+V+pass:0   #;

! (62) Participial Adjectives: modifies/describes a noun.
LEXICON ParticipialAdjectives
ea   VandAdj ; ! "be satisfied, be (re)paid"
he   VandAdj ; ! "unacquainted with"
hoha VandAdj ; ! "wearied at"
horo VandAdj ; ! "stormed (as a fort)"
mahora  VandAdj ; ! "given (as a feast)"
makini  VandAdj ; ! "gapped"
mana  VandAdj ; ! "ratified"
mao   VandAdj ; ! "ceased (as rain.)"
maoa  VandAdj ; ! "cooked (as food.)"
marae   VandAdj ; ! "(be) generous, hospitable"
marere  VandAdj ; ! "fallen to the ground"
maringi VandAdj ; ! "spilt"
maru    VandAdj ; ! "bruised, beaten"
matau   VandAdj ; ! "understood"
mate VandAdj ; ! "dead"
mau  VandAdj ; ! "caught"
mawheto  VandAdj ; ! "loosed (as a knot.)"
mimiti   VandAdj ; ! "dried up"
moti  VandAdj ; ! "destroyed, clean sweep"
motu  VandAdj ; ! "cut"
mutu  VandAdj ; ! "ended"
mākūkū VandAdj ; ! "be somewhat moist, wettish, damp"
mōhio  VandAdj ; ! "be accustomed, known, skilful, wise"
ngā  VandAdj ; ! V: "to take breath", Adj:"satisfied"
ngaro  VandAdj ; ! "lost, destroyed"
ngenge VandAdj ; ! "tired"
ngonga VandAdj ; ! "beaten"
ongeonge VandAdj ; ! "wearied at"
oti    VandAdj ; ! "finished"
pahemo VandAdj ; ! "dying, passing away"
pahure VandAdj ; ! "passed by"
pakaru VandAdj ; ! "broken"
pakeke VandAdj ; ! "(be) hard, difficult"
pareho VandAdj ; ! "consumed"
pau    VandAdj ; ! "exhausted, used up, finished"
pirau  VandAdj ; ! "rotten, beaten,decaying"
puku   VandAdj ; ! "secretly, silently, without speaking"
riro   VandAdj ; ! "departed"
rite   VandAdj ; ! "completus, perfectus"
riwha  VandAdj ; ! "gapped"
tahuri VandAdj ; ! "overturned"
taimaha  VandAdj ; ! "heavy, weighty, severe"
takitahi VandAdj ; ! "singly, solo, individual"
toremi VandAdj ; ! "sunk into"
tu     VandAdj ; ! "wounded"
tāwhito  VandAdj ; ! "old, ancient, out of date"
wera     VandAdj ; ! "hot, burnt"
werawera VandAdj ; ! "warm"
whanau VandAdj ; ! "brought forth, born"
whara  VandAdj ; ! "hurt (by accident)"

! (63) Tagging for participial adjectives
LEXICON VandAdj
 STag ;
 AdjTag ;

! (51) Adjectives
LEXICON Adjectives
hōu   AdjTag ; ! "new, modern, fresh"
iiti  AdjTag ; ! "very small"
iti   AdjTag ; ! "small"
iti   AdjTag ; ! "small"
kikino AdjTag ; ! "evil, bad, naughty"
kino   AdjTag ; ! "bad, badly"
kino  AdjTag ; ! "bad"
koi   AdjTag ; ! "good, suitable, appropriate"
koi   NTag ;    ! "spike, sharp splinter"
ma    AdjTag ; ! "clean, white"
nui   AdjTag ; ! "big"
nui   AdjTag ; ! "big"
nunui AdjTag ; ! "very big"
onepū AdjTag ; ! Adj: "sandy"
onepū NTag   ; ! N: "sand"
pai   AdjTag ; ! "good"
poto  AdjTag ; ! "short"
roa   AdjTag ; ! "long/tall"
roroa AdjTag ; ! "very long/tall"
tapu  AdjTag ; ! "be sacred, prohibited, restricted"
tapu  NTag ;   ! "restriction, prohibition "
tinana AdjTag ; ! "real, actual, actually, really"
tinana NTag ;   ! "self, person, torso"
toa   AdjTag ; ! Adj: "be brave, bold, victorious, experienced, accomplished, adept, competent, skilful, capable"
toa   NandV  ; ! also N, V
wera  AdjTag ; ! "hot"
werawera AdjTag ; ! "warm"
whāiti AdjTag ; ! "narrow, compact, crowded" -
whāiti NTag   ; ! also V: "be narrow, compact, packed"
whānui AdjTag ; ! Adj: "broad, wide, extensive"
whānui NTag   ; ! N: "width, breadth, range"
! Reduplication for adjectives is not modelled

! (52) Colours
LEXICON Colours
hiriwa    AdjTag ; ! "silver"
kahurangi AdjTag ; ! "blue"
kikorangi AdjTag ; ! "blue"
kura      AdjTag ; ! "basic red"
kākāriki  AdjTag ; ! "green"
kāriki    AdjTag ; ! "green"
kōura     AdjTag ; ! "gold"
kōwhai    AdjTag ; ! "yellow"
mā        AdjTag ; ! "white"
māmā      AdjTag ; ! "very white"
māwhero   AdjTag ; ! "pink"
mangu     AdjTag ; ! "black"
pango     AdjTag ; ! "black, dark"
papango   AdjTag ; ! "blackish"
parauri   AdjTag ; ! "brown"
parāone   AdjTag ; ! "brown" (loan)
popoto    AdjTag ; ! "very short"
poropango AdjTag ; ! "purple"
pāpura    AdjTag ; ! "purple" (loan)
pūmā      AdjTag ; ! "grey"
uri       AdjTag ; ! "dark green"
whero     AdjTag ; ! "red"

! (53) Tagging for Adjectives
LEXICON AdjTag
+Adj:0   #;

! 4. Locatives with location words and locative nouns ---------------------------------
! (64) Branching: Locationals vs. time constructs
LEXICON Locatives
 Locationals ;
 TimeLocations ;

! (38) Locatives, positions in space, usually allow whaka- as a directional prefix (cause/move toward ...)
LEXICON Locationals
mauī   LocTag ; ! "on the left hand, left side",whakamauī: "towards the left"
mua LocTag ; ! "the past, former(ly), first", whakamua: "forward, ahead, towards the front"
muri   LocTag ; ! "the rear, behind, at the back of", whakamuri: "backwards, behind, towards the rear."
raro  LocTag ; !  "the bottom, the underside, under", whakararo: "downwards, northwards"
runga  LocTag ; ! "above, over, up, upwards", whakarunga: "south, southern, upper, upwards"
runga  LocTag ; ! "up, on top", whakarunga "upwards, up, towards the top"
@D.PREF.Whaka@tai       LocTag ; ! "the sea, coast" ! whaka-prefix disallowed
@D.PREF.Whaka@waenganui LocTag ; ! "the middle, among, midst, amid, between"
waho   LocTag ; ! "the outside, out, the open sea, offshore", whakawaho: "outwards, out, seawards"

! (65) Locations, positions in time, usually dont take the whaka-prefix
LEXICON TimeLocations
aoake   PartLocTag ; ! "two days after tomorrow"
apōpō   PartLocTag ; ! "tomorrow"
hea   PartLocTag ; ! "any/other place, everywhere"
ianaianei PartLocTag ; ! "today"
inanahi PartLocTag ; ! "yesterday"
inapō   PartLocTag ; ! "last night"
pērā  PartLocTag ; ! "in that direction, there, that way"
āianei  PartLocTag ; ! "now, today, at present, soon"

! (39) Tagging for locatives
LEXICON LocTag
+Loc:0   #;

! 5. Personals  ---------------------------------
! (66) Personals inluding personal/possessive pronouns and numbers
LEXICON Personals
 PersPronouns ;
 PossPronouns ;
 Numerals ;
 OtherPersonals ;

! (67) Personal pronouns
LEXICON PersPronouns
au+Pers+1sg:au      # ; ! "I / me"
ahau+Pers+1sg:ahau  # ; ! "I / me"
koe+Pers+2sg:koe    # ; ! "you"
ia+Pers+3sg:ia      # ; ! "he / she / him / her"
tāua+Pers+1dl-incl:tāua  # ; ! "we / us" (= you + me)
māua+Pers+1dl-excl:māua  # ; ! "we / us" (= me + another one)
kōrua+Pers+2dl:kōrua     # ; ! "you two"
rāua+Pers+3dl:rāua       # ; ! "they / them" (exactly two)
tātou+Pers+1pl-incl:tātou # ; ! "we / us" (3+)
mātou+Pers+1pl-excl:mātou # ; ! "we / us" (3+, excludes listener)
koutou+Pers+2pl:koutou    # ; ! "you" (3+)
rātou+Pers+3pl:rātou      # ; ! "they / them" (3+)

! (36) Possessive pronouns
! 'a' and an 'o' class (alienable and inalienable possession not yet distinguished)
LEXICON PossPronouns
nāku+Poss+1sg:nāku # ; ! "mine / by me"
nōku+Poss+1sg:toku # ; ! "mine / belonging to me"
tāku+Poss+1sg:tāku # ; ! "my / mine"
tōku+Poss+1sg:tōku # ; ! "my / mine"
nāu+Poss+2sg:nāu   # ; ! "yours / by you"
nōu+Poss+2sg:nōu   # ; ! "yours / belonging to you""
tāu+Poss+2sg:āu    # ; ! "your / yours"
tōu+Poss+2sg:tōu   # ; ! "your / yours"
tō+Poss+2sg:tō     # ; ! "your / that of, the one of, the"
nāna+Poss+3sg:nāna # ; ! "his/hers / by him/her"
nōna+Poss+3sg:nōna # ; ! "his/hers / belonging to him/her"
tāna+Poss+3sg:tāna # ; ! "his/her"
tōna+Poss+3sg:tōna # ; ! "his/her"

māku+Poss+1sg:māku # ; ! "for me / mine to do"
mōku+Poss+1sg:mōku # ; ! "for me / intended for me"
māu+Poss+2sg:māu   # ; ! "for you / yours to do"
mōu+Poss+2sg:mōu   # ; ! "for you / intended for you"
māna+Poss+3sg:māna # ; ! "for him/her / theirs to do"
mōna+Poss+3sg:mōna # ; ! "for him/her / intended for him/her"
!wāna  1. (particle) (determiner) his, her (plural) - variation of the plural possessive āna.

! Numerals:
! (54) distinction: cardinal vs. ordinal numbers
!The prefix tua- functions as the ordinal marker, toko- as personal marker like in ....
LEXICON Numerals
card+:0  Numbers ;
ord+:tua Numbers ;
pers+:toko Numbers ;
tekau  NumTag ; ! "ten"
hia    NumTag ; ! "several, a number of, many"
kore   NumTag ; ! "zero, in mathematical contexts"
kotahi NumTag ; ! "be one, single, alone"
maha   NumTag ; ! "many, numerous, abundant"
mano   NumTag ; ! "thousand, (infinitely) large numbe"

! (27) Numbers 1 - 9:
LEXICON Numbers
tahi  NumTag ; ! "one"
rua   NumTag ; ! "two"
toru  NumTag ; ! "three"
whā   NumTag ; ! "four"
rima  NumTag ; ! "five"
ono   NumTag ; ! "six"
whitu NumTag ; ! "seven"
waru  NumTag ; ! "eight"
iwa   NumTag ; ! "nine"

! (28) Tagging for numerals
LEXICON NumTag
+Num:0 # ;

! (67) Other Personals, including  interrogative pronouns and personal nouns
LEXICON OtherPersonals
aha+Pron+q:aha   # ; ! "what?"
hea+Pron+q:hea   # ; ! "which? / where?"
hia+Pron+q:hia   # ; ! "how many? how long?"
wai+Pron+q:wai   # ; ! "who?"
whai+Pron+q:whai # ; ! "which? / what one?"

! 6. Particles -------------------------------
! (29) Particles: Distinction between different types:
LEXICON Particles
 Dets ;
 PartManner ;
 PartDirection ;
 PartLocation ;
 Parts ;
 TnsAspMde ;
 Prepositions ;
 Interjects ;

! (30) Determiners:
LEXICON Dets
te+Det+def+sg:te      # ; ! "the"
ngā+Det+def+pl:ngā    # ; ! "the (pl)"
he+Det+indef+sg:he    # ; ! "a, an, some"
tētahi+Det+indef+sg:tētahi  # ; ! "one, a, an, a certain, particula"
ētahi+Det+indef+pl:ētahi    # ; ! " some, others"

tēnei+Det+prox1+sg:tēnei # ; ! "this by me"
ēnei+Det+prox1+pl:ēnei   # ; ! "these by me"
nei+Det+prox1+adv:nei    # ; ! "here by me"

tēnā+Det+prox2+sg:tēnā  # ; ! "this by you"
ēnā+Det+prox2+pl:ēnā    # ; ! "these by you"
nā+Det+prox2+adv:nā     # ; ! "by you"

tērā+Det+Dis+sg:tērā  # ; ! "that over there"
ērā+Det+Dis+pl:ērā    # ; ! "those over there"
rā+Det+Dis+adv:rā     # ; ! "over there"
! aforementioned (already mentioned before): no adverb form
taua+Det+afo+sg:taua  # ; ! "that, the"
aua+Det+afo+sg:aua    # ; ! "those"
pēnei+Det:pēnei    # ; ! "like this, if, in that case."
pēna+Det:pēnā      # ; ! "like that, if"

! (31) Particles: manner
LEXICON PartManner
tonu+PartMnr:tonu # ; ! "noch"
rawa+PartMnr:rawa # ; ! "sehr"
noa+PartMnr:noa   # ; ! "ohne Einschränkung"
kē+PartMnr:kē     # ; ! "anders"
kau+PartMnr:kau   # ; ! "allein"
ki+PartMnr:ki     # ; ! "with, by means of"

! (32) Particles: direction
LEXICON PartDirection
mai+PartDir:mai  # ; ! "zum Sprecher hin"
atu+PartDir:atu  # ; ! "vom Sprecher weg"
ake+PartDir:ake  # ; ! "aufwärts"
iho+PartDir:iho  # ; ! "abwärts"
ki+PartDir:ki    # ; ! "to, into, towards, on to, upon"

! (33) Particles: location - no whaka-prefix allowed
LEXICON PartLocation
nei   PartLocTag ; ! "hier"
nā    PartLocTag ; ! "bei dir"
rā    PartLocTag ; ! "dort"
konei PartLocTag ; ! "this place, here/near"
konā  PartLocTag ; ! "that place, there"
korā  PartLocTag ; ! "over there, that place", no whaka

! (68) Tagging: Location Particles
LEXICON PartLocTag
+PartLoc:0 # ;

! (70) Tense, aspect and mood markers, aka tense particles:
LEXICON TnsAspMde
i+Tns:i     # ; ! temporal: past
ka+Tns:ka   # ; ! marks a phrase as verbal
kua+Tns:kua # ; ! temporal: perfect (completed)
kia+Tns:kia # ; ! temporal: future
e+Asp:e     # ; ! e ... ana progressive in any tense
ana+Asp:ana # ; ! e ... ana progressive in any tense
kei+Asp:kei # ; ! kei/i te progressive aspect, verbal markers
i+Asp:i     # ; ! kei/i te progressive aspect, verbal markers
te+Asp:te   # ; ! kei/i te progressive aspect, verbal markers
e+Mde:e     # ; ! e/∅ imperative marking
kia+Mde:kia # ; ! imperative, final clauses or wish/oder/request/right/good
me+Mde:me   # ; ! weak imperative: should/ought to

!(55) Prepositions
LEXICON Prepositions
a    PrepTag  ; ! "at, of, belonging to, until"
e    PrepTag  ; ! "by" (markin the agent)
i    PrepTag  ; ! "by, with, from"
o    PrepTag  ; ! "of, from, belonging to "
hei  PrepTag  ; ! "at, on, with" (future)
kei  PrepTag  ; ! "at, on with" (present)
koi  PrepTag  ; ! "while, when"
ko   PrepTag  ; ! "going to, at" (future, intention)
ma   PrepTag  ; ! "for, by"
me   PrepTag  ; ! "in addition"
mo   PrepTag  ; ! "at, on, for, concerning"
na   PrepTag  ; ! "belonging to, by means of"
no   PrepTag  ; ! "of, from"
ra   PrepTag  ; ! "through"
to   PrepTag  ; ! "up to"
whaka PrepTag  ; ! "towards"

! (56) Tagging: Prepositions
LEXICON PrepTag
+Prep:0 # ;

! (34) Particles: others
LEXICON Parts
ai   PartTag ; ! "wieder" (Harawima: Adverbs p. 48 f.)
anō  PartTag ; ! "wieder" (Harawima: Adverbs p. 48 f.)
hoki PartTag ; ! "auch"
ke   PartTag ; ! "already, long ago, instead"
ki   PartTag ; ! "to, into, towards, on to, upon"
ma   PartTag ; ! "and others" (plural indicator)
mā   PartTag ; ! "made by, via, through"
mō   PartTag ; ! "for, about, concerning"
nā   PartTag ; ! "of, belonging to"
nō   PartTag ; ! "belonging to, from"
oti  PartTag ; ! "but, then, so, exactly, indeed"
oti  PartTag ; ! "then, so, exactly, indeed"
pea  PartTag ; ! "vielleicht"
tā   PartTag ; ! "has, have, owns"
tū   PartTag ; ! "manner, sort, type of"
ā    PartTag ; ! "belongs to, from, attached to"
ō    PartTag ; ! "belongs to, from, attached to"

! (35) Tagging: Particles
LEXICON PartTag
+Part:0 # ;

! (37) Interjections
! Phrases and other words which do not belong to the other classes.
LEXICON Interjects
a      IntjTag ; ! "well, well then."
ā      IntjTag ; ! "yes" (variation of āe)
āe     IntjTag ; ! "yes"
aea    IntjTag ; ! "it would be better"
āna    IntjTag ; ! "yes, indeed, agreed" and: "no" in answer to a negative question.
ara    IntjTag ; ! "heck, look" (surprise or amazement)
aua    IntjTag ; ! "I don't know, don't ask"
aua    NegTag  ; ! "do not, don't - shortened form of kaua"
ehē    NegTag  ; ! "no"
ē      IntjTag ; !  concludes a line or the end of a traditional song
ira    IntjTag ; ! "look! look there!"
kaitoa IntjTag ; ! "It serves you right!"
kaua   NegTag  ; ! "do not, don't"
kore   NegTag  ; ! "no, never"
kāhore NegTag  ; ! "no, not"
kāo    NegTag  ; ! "no" (negative answer)
kāore  NegTag  ; ! "no, not"
kāpā   IntjTag ; ! "it's not as if, on the other hand"
pea    IntjTag ; ! "perhaps, maybe"
taihoa IntjTag ; ! "wait, not yet"
tētahi IntjTag ; ! "what a ..."

! (41) Tagging: Interjections
LEXICON IntjTag
+Intj:0 # ;

! (42) Tagging: Negations
LEXICON NegTag
+Neg:0 # ;

END

