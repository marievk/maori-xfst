Multichar_Symbols
    card+ ord+ pers+
    @P.PREF.Tua@
    @D.PREF.Tua@
    @R.PREF.Tua@

! tua- functions as the ordinal marker, toko- as personal marker
! tua + rua  -> tuarua "second", -> tokorua "two (people), pair, couple"
! tua + toru -> tuatoru = third, -> rokotoru "three (people)"

LEXICON Root
Numerals;

LEXICON Numerals
card+:0    Numbers ;
ord+:tua   Numbers ;
pers+:toko Numbers ;

LEXICON Numbers
rua   NumTag ; ! "two"
toru  NumTag ; ! "three"

LEXICON NumTag
+Num:0 # ;

! ---------------------------------------------
! cd .../xfsm_api/linux64/bin/
! ./xfst
! read lexc .../BuildingBlocks/tua-Prefix.xfst
! print upper-words; print lower-words
