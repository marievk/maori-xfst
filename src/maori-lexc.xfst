! 2. Verbs or universals -----------------------------------------
! (13) Verbs: Distinction between standard and partial/full reduplication
! (above/previously: dispatching for prefixes)
LEXICON Verbs
Verb ;
0:^[{ VerbStems ;     ! full reduplication V => V
0:^[{ VerbDupNomin ; ! full reduplication V => N
IniVDup ;             ! partial reduplication V => V

! (14) Verbs: activities / transitive verbs
LEXICON Verb
a     VTag ;      ! "to drive away"
a     iaPassive ; ! -> aia
aha   VTag ; ! "do anything"
ao    VTag ; ! "bark" (dog)
arahi VTag ;       ! "to guide"
arahi inaPassive ; ! -> arahina
aroha VTag       ; ! "to love"
aroha inaPassive ; ! -> arohaina
aroha tiaPassive ; ! -> arohatia
haere VTag ;       ! "walk, come, go"
haere aPassive ;   ! -> haerea
haere hiaPassive ; ! -> haerehia
haere tiaPassive ; ! -> haeretia
hahau VTag ;       ! "to seek"
hahau riaPassive ; ! -> hahauria
haka   VTag ; ! "dance, perform the haka"
haka   aPassive   ; ! -> hakaa
haka   iaPassive  ; ! -> hakahia
haka   inaPassive ; ! -> hakaina
haka   tiaPassive ; ! -> hakatia
hanga VTag ;       ! "make, build, create"
hanga aPassive;    ! -> hangaa
haupapa VTag ;     ! "freeze"
he     VTag ;        ! "unacquainted with"
he     ngiaPassive ; ! -> hengia
hi     VTag ;     ! "to fish with a hook"
hi     aPassive ; ! -> hia
hoatu  0Passive ;  ! -> hoatu
hoatu  VTag ;      ! " put, add, hand ove"
hoatu  hiaPassive ; ! -> hoatuhia
hoatu  riaPassive ; ! -> hoaturia
homai  0Passive ;   ! -> homai
homai  VTag   ;     ! "give, contribute, grant, provide"
homai  hiaPassive ; ! -> homaihia
homai  tiaPassive ; ! -> homaitia
hopu  VTag ;       ! "catch"
hopu  kiaPassive;  ! -> hopukia -ina
hopu VNkanga ;     ! "catch, seize", ->  hopukanga "catching, seizing"
hopu kinaPassive ; ! -> hopukina "be caught/seized"
hora   VTag ; ! "to spread out, display, make public"
horo VTag ;        ! "to swallow"
horo miaPassive  ; ! -> horomia
horo ngiaPassive ; ! -> horongia
horoi  VTag ;    ! "clean"
horoi  aPassive; ! -> horoia
hura VTag ;      ! "to expose"
hura hiaPassive  ; ! -> hurahia, or hurangia
hura ngiaPassive ; ! -> hurangia
inu  VTag ;        ! "drink"
inu  miaPassive;   ! -> inumia
ka   VTag ;        ! "to light (as a fire)"
ka   ngiaPassive ; ! -> kangia
kaa  VNinga ;   ! V: "take fire, burn, be lighted"  => -inga kaainga "home, village, place where fire is lighted"
kai   VTag ; ! "eat"
kai   ngaPassive ; ! -> kainga
karanga VTag  ; ! V: "to call, call out, shout, "
kaumātua NandV ; ! V: "grow old, grow up", N: "adult, elder, person of status"
kaumātua tiaPassive  ; ! - > kaumātuatia
kite  aPassive ; ! "see, perceive, find, discover, detect."
ko  VTag ;        ! -> kongia
ko  ngiaPassive ; ! "to dig" -> kongia
koara VTag ;       ! V: "be split open, force open"
koara tiaPassive ; ! -> koaratia
kohete VTag ;       !"scold, tell/tick off"
kohete tiaPassive ; ! -> kohetetia
korero  VTag ;    ! "tell, say, speak"
korou VTag ;        ! "to desire, long for, fancy, wish for, want"
korou ngiaPassive ; ! -> koroungia
korou tiaPassive  ; ! -> koroutia
koroua  VTag ; ! "to be old, elderly"
kukume  VTag ;     ! "to pull"
kukume  aPassive ; ! -> kumea
kā   VNinga  ; ! V: "to burn, glow", -inga kāinga: N: "home, address, residence, village"
kāwana  VNtanga ;    ! V: "to govern" => kāwanatanga  "government, rule, authority"
kāwana  tiaPassive ; ! -> kāwanatia
kī  NandV      ; ! V: "say, speak, express, mention, tell", N: "saying, word"
kī  aPassive   ; ! -> kīa
kī  iaPassive  ; ! -> kīia
kī  tiaPassive ; ! -> kītia
mahora VTag ; ! "be spread out, laid out, served"
maka VTag ;     ! "to throw away" -> makā, rewrite: aa => ā
maka aPassive ; ! -> makā, rewrite: aa => ā
manako   VTag ;       ! "to set one's heart on, like, want"
manako   hiaPassive ; ! -> manakohia
manako   tiaPassive ; ! -> manakotia
matenui VTag ;       ! "desire earnestly, show attention"
matenui hiaPassive ; ! -> matenuihia
matenui tiaPassive ; ! -> matenuitia
